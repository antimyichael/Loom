{
  "name": "antimyichael/loom",
  "version": "0.2.1",
  "description": "Weave your codebase into a navigable Obsidian vault.",
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "electron/main.cjs",
  "bin": {
    "loom": "./bin/loom.js"
  },
  "files": [
    "bin/",
    "electron/",
    "build/",
    "README.md",
    "LICENSE",
    "install.sh"
  ],
  "scripts": {
    "start": "electron electron/main.cjs",
    "app": "electron electron/main.cjs",
    "postinstall": "node ./bin/install.js",
    "build": "cargo build --release",
    "test": "cargo test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.loomcode.loom",
    "productName": "Loom",
    "copyright": "Copyright © 2026 Loom Contributors",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "target/release/loom",
          "to": "bin/loom"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "target/release/loom.exe",
          "to": "bin/loom.exe"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Loom"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "extraResources": [
        {
          "from": "target/release/loom",
          "to": "bin/loom"
        }
      ],
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "keywords": [
    "obsidian",
    "codebase",
    "ast",
    "tree-sitter",
    "documentation",
    "graph",
    "cli"
  ],
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
